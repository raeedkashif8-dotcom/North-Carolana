# Copy to .env (git-ignored) and fill in.

# Supabase > Project Settings > Database > Connection string > "Session pooler" (port 5432).
# Not the "Transaction pooler" (port 6543): it breaks the row locks the job system uses.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Local fake inbox (docker compose up -d)
SMTP_HOST=localhost
SMTP_PORT=1025
